{
  "name": "VENDOR/NEW_PLUGIN_NAME",
  "description": "NEW_PLUGIN_NAME plugin for wordpress",
  "type": "wordpress-plugin",
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "NEW_PLUGIN_NAME\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  }
}

